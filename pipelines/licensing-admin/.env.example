# ==============================================================================
# WPipe Studio - Cloudflare Admin Dashboard Environment Variables
# Author: William Rodriguez (wisrovi.dev)
# ==============================================================================

# Cloudflare Account & D1 Database IDs
CLOUDFLARE_ACCOUNT_ID=<your_cloudflare_account_id>
CLOUDFLARE_D1_DATABASE_ID=<your_cloudflare_d1_database_id>

# Cloudflare API Token (Requires D1:Edit permission)
CLOUDFLARE_API_TOKEN=<your_cloudflare_api_token>

# Admin Dashboard Password Gate
ADMIN_PASSWORD=<your_admin_password>

# Cloudflare Worker Edge API Base URL
API_BASE_URL=https://api.wisrovi.dev
